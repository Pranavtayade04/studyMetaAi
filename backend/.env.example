# Copy this file to ".env" and fill in real values.
# ".env" is gitignored and must never be committed.

# Local MongoDB default. Replace with your Atlas URI if using Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/studymate

# Secret used to sign/verify JWTs — use a long random string
JWT_SECRET=

# Google Gemini API key — used ONLY on the backend.
# The React frontend must never see or call this directly.
GEMINI_API_KEY=

# Optional Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Port the Express server runs on
PORT=5000
